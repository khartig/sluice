{
  "name": "sluice",
  "version": "0.0.1",
  "private": true,
  "description": "A blind-relay host for groups that run their own relay: wire-compatible with Pear's, with logging and limits its operator chooses.",
  "license": "MIT",
  "bin": {
    "sluice": "bin/sluice.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "node bin/sluice.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "blind-relay": "1.6.1",
    "hyperdht": "6.36.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
